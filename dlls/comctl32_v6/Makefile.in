MODULE    = comctl32_v6.dll
IMPORTS   = uuid user32 gdi32 advapi32 imm32 kernelbase oleaut32
DELAYIMPORTS = oleacc winmm uxtheme
EXTRADEFS = -D_COMCTL32_ -D__WINE_COMCTL32_VERSION=6
PARENTSRC = ../comctl32

VER_FILEDESCRIPTION_STR = "Wine Common Controls"
VER_PRODUCTVERSION      = 6,0,2600,2982
VER_INTERNALNAME_STR    = "comctl32.dll"

SOURCES = \
	animate.c \
	button.c \
	combo.c \
	comboex.c \
	comctl32.rc \
	commctrl.c \
	datetime.c \
	dpa.c \
	draglist.c \
	dsa.c \
	edit.c \
	flatsb.c \
	header.c \
	hotkey.c \
	imagelist.c \
	ipaddress.c \
	listbox.c \
	listview.c \
	monthcal.c \
	nativefont.c \
	pager.c \
	progress.c \
	propsheet.c \
	rebar.c \
	rsrc.rc \
	smoothscroll.c \
	static.c \
	status.c \
	string.c \
	syslink.c \
	tab.c \
	taskdialog.c \
	toolbar.c \
	tooltips.c \
	trackbar.c \
	treeview.c \
	updown.c
